# IncidentPulse AI - Backend Environment Configuration

# Server Port
PORT=3005

# Google Gemini API Configuration
# Optional: If not provided, IncidentPulse AI gracefully falls back to deterministic simulated streaming mode
GEMINI_API_KEY=

# Node Environment
NODE_ENV=development

# Simulator configuration
SIMULATOR_LOG_INTERVAL_MS=600
SIMULATOR_METRICS_INTERVAL_MS=1000
